#!/usr/bin/env bash
# Runs fantasy-ai out of the project's virtual environment, so you never have
# to activate it:  ./fantasy-ai analyze board
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
FA="$ROOT/.venv/bin/fantasy-ai"
if [ ! -x "$FA" ]; then
  echo "Virtual environment not found. Run ./setup.sh first." >&2
  exit 1
fi
exec "$FA" "$@"
