# In .gitattributes the LAST matching pattern wins, so the catch-all goes
# first and the specific overrides follow it.
* text=auto eol=lf

# Windows launchers must arrive with CRLF endings. cmd.exe mis-parses LF-only
# batch files, and that failure looks like a broken script rather than a
# line-ending problem, so pin it here rather than relying on core.autocrlf.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
